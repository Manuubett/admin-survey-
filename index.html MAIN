function getFiltered(){
  const c=v('gf-constituency'),w=v('gf-ward'),g=v('gf-gender'),a=v('gf-age'),gv2=v('gf-governor');
  return rawData.filter(d=>{
    if(c&&d.constituency!==c)return false;
    if(w&&d.ward!==w)return false;
    if(g&&d.gender!==g)return false;
    if(a&&d.age!==a)return false;
    if(gv2&&d.governor!==gv2)return false;
    return true;
