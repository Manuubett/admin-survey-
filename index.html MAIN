<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ECS-2026 · Analytics Intelligence</title>
<script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-firestore-compat.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#0c1a0e;--forest:#1a4a2a;--leaf:#2d7a45;--mint:#4caf78;--sage:#a8d5b5;
  --cream:#f7f4ee;--warm:#ede8df;--gold:#c8963e;--gold-lt:#f0d9a8;
  --red:#b83232;--sky:#2563a8;--border:#d6cfc2;--muted:#7a6f62;--muted2:#b0a89e;
  --r:8px;--sh:0 2px 16px rgba(12,26,14,.09);
  --signal:#b83232;--signal-l:#fef2f2;
  --teal:#1a4a2a;--teal-l:#f0fdf4;
  --gold2:#c8963e;--gold-l:#fffbeb;
  --slate:#2563a8;--slate-l:#eff6ff;
  --plum:#6b3fa0;--plum-l:#faf5ff;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'DM Sans',system-ui,sans-serif;background:var(--cream);color:var(--ink);font-size:14px;min-height:100vh;}

/* ── LOGIN ── */
#loginWall{position:fixed;inset:0;background:var(--forest);z-index:9999;display:flex;align-items:center;justify-content:center;overflow:hidden;}
#loginWall::before{content:'ECS';position:absolute;right:-40px;bottom:-60px;font-family:'Fraunces',serif;font-size:280px;font-weight:700;color:rgba(255,255,255,.04);line-height:1;pointer-events:none;}
.l-card{background:#fff;border-radius:20px;padding:40px 36px;width:100%;max-width:400px;box-shadow:0 32px 80px rgba(0,0,0,.3);text-align:center;position:relative;z-index:2;}
.l-logo{width:56px;height:56px;border-radius:14px;background:linear-gradient(135deg,var(--forest),var(--leaf));display:flex;align-items:center;justify-content:center;margin:0 auto 18px;font-family:'Fraunces',serif;font-size:20px;font-weight:700;color:#fff;}
.l-title{font-family:'Fraunces',serif;font-size:22px;font-weight:700;color:var(--forest);margin-bottom:4px;}
.l-sub{font-size:13px;color:var(--muted);margin-bottom:24px;}
.l-inp{width:100%;padding:11px 13px;border:1.5px solid var(--border);border-radius:8px;font-size:14px;background:var(--cream);color:var(--ink);margin-bottom:10px;font-family:inherit;}
.l-inp:focus{outline:none;border-color:var(--leaf);background:#fff;}
.l-err{color:var(--red);font-size:12px;margin-bottom:10px;display:none;}
.l-btn{width:100%;padding:13px;background:linear-gradient(135deg,var(--forest),var(--leaf));color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;}
.l-btn:hover{opacity:.88;}

/* ── TOPBAR ── */
.topbar{background:var(--forest);height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;z-index:100;border-bottom:2px solid var(--leaf);}
.tb-brand{display:flex;align-items:center;gap:12px;}
.tb-dot{width:9px;height:9px;border-radius:50%;background:var(--mint);box-shadow:0 0 0 3px rgba(76,175,120,.25);animation:pdot 2s ease-in-out infinite;flex-shrink:0;}
@keyframes pdot{0%,100%{box-shadow:0 0 0 3px rgba(76,175,120,.25)}50%{box-shadow:0 0 0 6px rgba(76,175,120,.1)}}
.tb-name{font-family:'Fraunces',serif;font-size:16px;font-weight:700;color:#fff;}
.tb-sub{font-size:11px;color:var(--sage);margin-left:4px;}
.tb-meta{display:flex;align-items:center;gap:12px;}
.tb-chip{display:flex;align-items:center;gap:6px;font-size:11px;color:rgba(255,255,255,.45);background:rgba(255,255,255,.08);padding:5px 12px;border-radius:20px;border:1px solid rgba(255,255,255,.08);}
.tb-chip strong{color:rgba(255,255,255,.8);font-weight:500;}
.tb-note{font-size:10px;color:rgba(255,255,255,.3);font-style:italic;}
.tb-actions{display:flex;gap:8px;}
.tbtn{display:inline-flex;align-items:center;gap:5px;padding:7px 15px;border-radius:var(--r);font-size:13px;font-weight:600;cursor:pointer;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.08);color:rgba(255,255,255,.8);transition:all .15s;font-family:inherit;white-space:nowrap;}
.tbtn:hover{background:rgba(255,255,255,.15);color:#fff;}
.tbtn.primary{background:var(--gold);color:var(--ink);border-color:var(--gold);}
.tbtn.primary:hover{background:#b07a2a;color:#fff;}
.tbtn:disabled{opacity:.4;pointer-events:none;}

/* ── TABS ── */
.tabs-bar{background:var(--ink);border-bottom:1px solid rgba(255,255,255,.07);padding:0 28px;display:flex;gap:2px;overflow-x:auto;}
.tab{padding:13px 18px;font-size:13px;font-weight:500;color:rgba(255,255,255,.4);cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent;transition:all .15s;}
.tab:hover{color:rgba(255,255,255,.75);}
.tab.active{color:#fff;border-bottom-color:var(--gold);}

/* ── LOADING ── */
#loadingOverlay{position:fixed;inset:0;background:var(--cream);z-index:500;display:none;flex-direction:column;align-items:center;justify-content:center;gap:20px;}
.spinner{width:44px;height:44px;border:3px solid var(--border);border-top-color:var(--leaf);border-radius:50%;animation:spin .7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}
.load-txt{font-size:13px;color:var(--muted);}

/* ── LAYOUT ── */
.page{max-width:1600px;margin:0 auto;padding:24px 28px 60px;}

/* ── HERO STATS ── */
.hero-stats{display:grid;grid-template-columns:repeat(8,1fr);gap:10px;margin-bottom:8px;}
.hstat{background:var(--ink);border:1px solid rgba(255,255,255,.07);border-radius:var(--r);padding:14px 16px;position:relative;overflow:hidden;}
.hstat::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;border-radius:var(--r) var(--r) 0 0;}
.hs-green::before{background:var(--leaf);}
.hs-gold::before{background:var(--gold);}
.hs-sky::before{background:var(--sky);}
.hs-red::before{background:var(--red);}
.hstat-label{font-size:10px;font-weight:600;letter-spacing:.7px;text-transform:uppercase;color:rgba(255,255,255,.35);margin-bottom:6px;}
.hstat-val{font-size:26px;font-weight:600;color:#fff;line-height:1;font-variant-numeric:tabular-nums;}
.hstat-sub{font-size:11px;color:rgba(255,255,255,.3);margin-top:4px;}
.hero-note{font-size:11px;color:var(--muted);font-style:italic;margin-bottom:16px;padding:0 2px;}

/* ── FILTER BAR ── */
.filter-bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:#fff;border:1px solid var(--border);border-radius:var(--r);padding:11px 16px;margin-bottom:20px;}
.filter-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);white-space:nowrap;}
.fsel{padding:7px 12px;border:1.5px solid var(--border);border-radius:6px;font-size:13px;background:var(--cream);color:var(--ink);cursor:pointer;font-family:inherit;}
.fsel:focus{outline:none;border-color:var(--leaf);}
.fsel-spacer{flex:1;}
.fclr{padding:7px 14px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;border:1px solid var(--border);background:#fff;color:var(--muted);font-family:inherit;}
.fclr:hover{border-color:var(--red);color:var(--red);}

/* ── TAB CONTENT ── */
.tab-content{display:none;}
.tab-content.active{display:block;}
.section-label{font-size:11px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--leaf);margin-bottom:14px;display:flex;align-items:center;gap:10px;}
.section-label::after{content:'';flex:1;height:1px;background:var(--border);}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;}
.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:20px;}
.grid-4{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:16px;margin-bottom:20px;}
.span2{grid-column:span 2;}
.span3{grid-column:span 3;}

/* ── CARD ── */
.card{background:#fff;border:1px solid var(--border);border-radius:12px;overflow:hidden;}
.card-head{padding:14px 18px 0;display:flex;align-items:flex-start;justify-content:space-between;}
.card-title{font-size:13px;font-weight:700;color:var(--ink);}
.card-sub{font-size:11px;color:var(--muted);margin-top:2px;}
.card-badge{font-size:10px;font-weight:600;padding:3px 9px;border-radius:20px;white-space:nowrap;margin-top:2px;}
.bg-green{background:var(--teal-l);color:var(--teal);}
.bg-gold{background:var(--gold-l);color:#92400e;}
.bg-red{background:var(--signal-l);color:var(--signal);}
.bg-sky{background:var(--slate-l);color:var(--slate);}
.bg-plum{background:var(--plum-l);color:var(--plum);}
.card-body{padding:14px 18px 16px;}

/* ── HBAR ── */
.hbar-list{display:flex;flex-direction:column;gap:9px;}
.hbar-meta{display:flex;justify-content:space-between;margin-bottom:4px;}
.hbar-label{font-size:12px;color:var(--ink);font-weight:500;}
.hbar-vals{display:flex;align-items:center;gap:7px;}
.hbar-pct{font-size:12px;color:var(--muted);}
.hbar-n{font-size:11px;color:var(--muted2);}
.hbar-track{height:7px;background:var(--warm);border-radius:4px;overflow:hidden;}
.hbar-fill{height:100%;border-radius:4px;transition:width 1s cubic-bezier(.16,1,.3,1);}
.fill-green{background:var(--leaf);}
.fill-gold{background:var(--gold);}
.fill-red{background:var(--red);}
.fill-sky{background:var(--sky);}
.fill-plum{background:var(--plum);}

/* ── DONUT ── */
.donut-wrap{position:relative;max-width:200px;margin:0 auto;}
.donut-center{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;pointer-events:none;}
.donut-big{font-size:24px;font-weight:600;color:var(--ink);line-height:1;}
.donut-lbl{font-size:10px;color:var(--muted);margin-top:2px;}
.legend{display:flex;flex-wrap:wrap;gap:9px;margin-top:12px;}
.leg-item{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--ink);}
.leg-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}

/* ── KPI GRID ── */
.kpi-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.kpi-tile{background:var(--warm);border-radius:var(--r);padding:12px 14px;text-align:center;}
.kpi-val{font-size:26px;font-weight:600;color:var(--ink);line-height:1;}
.kpi-lbl{font-size:11px;color:var(--muted);margin-top:4px;}

/* ── SCORE TABLE ── */
.score-table{width:100%;border-collapse:collapse;}
.score-table tr{border-bottom:1px solid var(--warm);}
.score-table tr:last-child{border-bottom:none;}
.score-table td{padding:8px 4px;font-size:13px;}
.score-table td:first-child{color:var(--ink);font-weight:500;}
.sb-wrap{display:flex;align-items:center;gap:7px;}
.sb-track{flex:1;height:6px;background:var(--warm);border-radius:4px;overflow:hidden;}
.sb-fill{height:100%;border-radius:4px;background:var(--leaf);}
.sb-num{font-size:12px;color:var(--muted);white-space:nowrap;}

/* ── CROSS-TAB ── */
.xtab{width:100%;border-collapse:collapse;font-size:12px;}
.xtab th{padding:8px 10px;background:var(--warm);font-weight:600;color:var(--ink);text-align:left;border-bottom:2px solid var(--border);white-space:nowrap;}
.xtab td{padding:7px 10px;border-bottom:1px solid var(--warm);color:var(--muted);}
.xtab td:first-child{font-weight:500;color:var(--ink);}
.xtab tr:hover td{background:var(--cream);}
.mini-bar{display:flex;align-items:center;gap:5px;}
.mini-track{width:56px;height:5px;background:var(--warm);border-radius:3px;overflow:hidden;}
.mini-fill{height:100%;border-radius:3px;background:var(--leaf);}

/* ── WORD CLOUD ── */
.word-cloud{display:flex;flex-wrap:wrap;gap:8px;align-items:center;}
.word-pill{border-radius:20px;padding:4px 12px;cursor:default;transition:transform .15s;white-space:nowrap;}
.word-pill:hover{transform:scale(1.05);}

/* ── PRIORITY LIST ── */
.pr-row{display:flex;align-items:center;gap:11px;padding:9px 0;border-bottom:1px solid var(--warm);}
.pr-row:last-child{border-bottom:none;}
.pr-rank{width:26px;height:26px;border-radius:50%;background:var(--ink);color:#fff;font-size:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.pr-rank.r1{background:var(--red);}
.pr-rank.r2{background:var(--gold);}
.pr-rank.r3{background:var(--leaf);}
.pr-text{flex:1;font-size:13px;color:var(--ink);font-weight:500;}
.pr-bar-track{flex:1;max-width:80px;height:5px;background:var(--warm);border-radius:3px;overflow:hidden;}
.pr-bar-fill{height:100%;border-radius:3px;background:var(--red);}
.pr-score{font-size:12px;color:var(--muted);}

/* ── INSIGHT BOX ── */
.insight{background:linear-gradient(135deg,var(--forest),#2d5a3d);border-radius:var(--r);padding:16px 20px;margin-bottom:18px;border-left:3px solid var(--gold);}
.insight-label{font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--gold);margin-bottom:7px;}
.insight-text{font-size:13px;color:rgba(255,255,255,.8);line-height:1.7;}
.insight-text strong{color:#fff;}

/* ── CHART WRAP ── */
.ch-wrap{position:relative;height:220px;}
.ch-wrap.tall{height:280px;}
.ch-wrap.short{height:160px;}
.no-data{text-align:center;padding:36px 16px;color:var(--muted2);font-size:13px;}

/* ── REPORT ── */
.report-wrap{max-width:900px;margin:0 auto;}
.report-actions{display:flex;gap:10px;justify-content:flex-end;margin-bottom:20px;}
.report-doc{background:#fff;border:1px solid var(--border);border-radius:12px;padding:52px 60px;line-height:1.8;color:var(--ink);}
.r-cover{text-align:center;border-bottom:2px solid var(--ink);padding-bottom:32px;margin-bottom:36px;}
.r-cover .r-logo{width:50px;height:50px;background:linear-gradient(135deg,var(--forest),var(--leaf));border-radius:12px;display:inline-flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:16px;box-shadow:var(--sh);}
.r-cover h1{font-family:'Fraunces',serif;font-size:26px;font-weight:700;margin-bottom:6px;}
.r-cover .r-sub{font-size:14px;color:var(--muted);margin-bottom:18px;}
.r-cover .r-meta{display:flex;justify-content:center;gap:28px;font-size:12px;color:var(--muted);}
.r-cover .r-meta strong{color:var(--ink);}
.r-toc{background:var(--warm);border-radius:var(--r);padding:22px 26px;margin-bottom:36px;}
.r-toc h3{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:10px;}
.r-toc ol{list-style:none;counter-reset:toc;display:grid;grid-template-columns:1fr 1fr;gap:5px;}
.r-toc ol li{counter-increment:toc;font-size:13px;color:var(--ink);display:flex;align-items:center;gap:7px;cursor:pointer;}
.r-toc ol li:hover{color:var(--leaf);}
.r-toc ol li::before{content:counter(toc,decimal-leading-zero);font-size:10px;color:var(--muted2);width:20px;flex-shrink:0;}
.r-section{margin-bottom:36px;scroll-margin-top:80px;}
.r-section h2{font-family:'Fraunces',serif;font-size:18px;font-weight:700;border-left:4px solid var(--leaf);padding-left:12px;margin-bottom:12px;}
.r-section h3{font-size:14px;font-weight:700;color:var(--ink);margin:18px 0 7px;text-transform:uppercase;letter-spacing:.5px;}
.r-section p{font-size:14px;color:var(--ink);margin-bottom:10px;}
.r-section ul{padding-left:18px;margin-bottom:12px;}
.r-section ul li{font-size:14px;color:var(--ink);margin-bottom:5px;}
.r-table{width:100%;border-collapse:collapse;margin:12px 0 18px;font-size:13px;}
.r-table th{background:var(--forest);color:#fff;padding:8px 11px;text-align:left;font-weight:600;font-size:12px;letter-spacing:.3px;}
.r-table td{padding:7px 11px;border-bottom:1px solid var(--warm);color:var(--ink);}
.r-table tr:hover td{background:var(--cream);}
.r-table td.num{font-variant-numeric:tabular-nums;color:var(--ink);font-weight:600;}
.r-callout{border-left:4px solid var(--red);background:var(--signal-l);padding:12px 16px;border-radius:0 var(--r) var(--r) 0;margin:12px 0;font-size:13px;color:var(--ink);}
.r-callout strong{color:var(--red);}
.r-callout.green{border-left-color:var(--leaf);background:var(--teal-l);}
.r-callout.green strong{color:var(--forest);}
.r-callout.gold{border-left-color:var(--gold);background:var(--gold-l);}
.r-callout.gold strong{color:#92400e;}
.r-divider{border:none;border-top:1px solid var(--border);margin:32px 0;}
.r-badge-row{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 14px;}
.r-badge{display:inline-flex;align-items:center;gap:5px;padding:5px 13px;border-radius:20px;font-size:12px;font-weight:600;}
.rb-green{background:var(--teal-l);color:var(--forest);}
.rb-gold{background:var(--gold-l);color:#92400e;}
.rb-red{background:var(--signal-l);color:var(--red);}
.rb-sky{background:var(--slate-l);color:var(--slate);}
.r-finding{background:linear-gradient(135deg,var(--forest),#2d5a3d);border-radius:var(--r);padding:24px 28px;margin:20px 0;color:rgba(255,255,255,.85);font-size:14px;line-height:1.8;}
.r-finding h3{color:#fff;font-size:16px;margin-bottom:12px;margin-top:0;border-bottom:1px solid rgba(255,255,255,.1);padding-bottom:8px;}
.r-finding p{color:rgba(255,255,255,.75);}
.r-finding strong{color:#fff;}
@media(max-width:900px){.report-doc{padding:28px 22px;}.r-toc ol{grid-template-columns:1fr;}}
@media(max-width:1200px){.hero-stats{grid-template-columns:repeat(4,1fr);}}
@media(max-width:900px){.grid-3,.grid-4{grid-template-columns:1fr 1fr;}.hero-stats{grid-template-columns:repeat(4,1fr);}.page{padding:16px 16px 40px;}.span2,.span3{grid-column:span 1;}}
@media(max-width:640px){.hero-stats{grid-template-columns:repeat(2,1fr);}.grid-2,.grid-3,.grid-4{grid-template-columns:1fr;}}
@media print{.topbar,.tabs-bar,.hero-stats,.filter-bar,.report-actions{display:none!important;}.tab-content{display:block!important;}.report-doc{border:none;padding:0;}body{background:#fff;}}

/* TOAST */
#toast{position:fixed;bottom:22px;right:22px;padding:11px 18px;border-radius:8px;font-size:13px;font-weight:600;box-shadow:var(--sh);transform:translateY(80px);opacity:0;transition:all .3s cubic-bezier(.34,1.56,.64,1);z-index:600;color:#fff;}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="loginWall">
  <div class="l-card">
    <div class="l-logo">ECS</div>
    <div class="l-title">ECS-2026 Analytics</div>
    <div class="l-sub">Embu County Social Study · Intelligence Portal</div>
    <input class="l-inp" id="lu" type="text" placeholder="Username" autocomplete="off">
    <input class="l-inp" id="lp" type="password" placeholder="Password">
    <p class="l-err" id="lerr">Incorrect credentials. Please try again.</p>
    <button class="l-btn" onclick="doLogin()">Access Analytics →</button>
  </div>
</div>

<!-- LOADING -->
<div id="loadingOverlay">
  <div class="spinner"></div>
  <div class="load-txt" id="loadMsg">Loading survey data…</div>
</div>

<!-- TOPBAR -->
<div class="topbar">
  <div class="tb-brand">
    <div class="tb-dot"></div>
    <div><span class="tb-name">ECS-2026</span><span class="tb-sub">Analytics</span></div>
  </div>
  <div class="tb-meta">
    <div class="tb-chip"><span>N =</span><strong id="tm-n">—</strong></div>
    <div class="tb-chip"><span>Updated</span><strong id="tm-time">—</strong></div>
    <div class="tb-chip"><span>Researchers</span><strong id="tm-res">—</strong></div>
  </div>
  <div class="tb-actions">
    <button class="tbtn" onclick="refreshData()" id="refreshBtn">↻ Refresh</button>
    <button class="tbtn" onclick="switchTab('report',document.querySelector('[data-tab=report]'))">📄 Report</button>
    <button class="tbtn primary" onclick="exportExcel()">⬇ Export Excel</button>
  </div>
</div>

<!-- TABS -->
<div class="tabs-bar">
  <div class="tab active" data-tab="overview"     onclick="switchTab('overview',this)">Overview</div>
  <div class="tab" data-tab="demographics"        onclick="switchTab('demographics',this)">Demographics</div>
