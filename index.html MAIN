/* ══════════ OCCUPATION NORMALIZER ══════════ */
function normalizeOcc(val){
  if(!val)return'';
  const v=val.toLowerCase().trim();
  if(/farm|agri|livestock|horti|agro/.test(v))             return'Farming / Agriculture';
  if(/teacher|tutor|lecturer|ecde|instruct|school/.test(v)) return'Teaching / Education';
  if(/shop|retail|wholesale|hawker|vendor|market|restaurant|food business|online business/.test(v)) return'Business / Trade';
  if(/doctor|nurse|clinical|midwife|medical/.test(v))      return'Health Professional';
  if(/engineer|accountant|lawyer|advocate|ict|technology|banker|finance|government officer|ngo|non-profit/.test(v)) return'Professional / Specialist';
  if(/matatu|boda|driver|conductor|truck|lorry|taxi|cab|transport/.test(v)) return'Transport / Logistics';
  if(/mason|fundi|carpenter|electrician|plumber|mechanic|tailor|seamstress|welder|metal|hairdresser|barber/.test(v)) return'Artisan / Skilled Trade';
  if(/police|defence|prison|warden/.test(v))               return'Uniformed Services';
  if(/pastor|clergy|social worker|community health/.test(v)) return'Community / Clergy';
  if(/casual|domestic/.test(v))                            return'Casual / Domestic Worker';
  if(/student/.test(v))                                    return'Student';
  if(/retired/.test(v))                                    return'Retired';
  if(/unemploy/.test(v))                                   return'Unemployed';
  if(/business|trade|entrepreneur|self.employ/.test(v))    return'Business / Trade';
  return val.length>40?val.slice(0,38)+'…':val.trim();
}

/* ══════════ CLEAN CANDIDATE FREQ (strips __other__ sentinel) ══════════ */
function cleanCandFreq(field){
