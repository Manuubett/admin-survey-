/* ══════════ HELPERS ══════════ */
function freq(arr,key){const m={};arr.forEach(d=>{const vv=d[key];if(vv)m[vv]=(m[vv]||0)+1;});return m;}
function freqMulti(arr,key){const m={};arr.forEach(d=>{const vs=d[key];if(Array.isArray(vs))vs.forEach(v=>{if(v)m[v]=(m[v]||0)+1;});});return m;}
function pct(n,t){return t?Math.round(n/t*100):0;}
function sortDesc(obj){return Object.entries(obj).sort((a,b)=>b[1]-a[1]);}
function esc(s){return s?String(s).replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/&/g,'&amp;'):''}
function meanScore(arr,key,sm){const vs=arr.map(d=>sm[d[key]]).filter(v=>v!==undefined);return vs.length?vs.reduce((a,b)=>a+b,0)/vs.length:0;}

function mkChart(id,cfg){
  if(charts[id])charts[id].destroy();
  const ctx=document.getElementById(id);
  if(!ctx)return;
  charts[id]=new Chart(ctx,cfg);
}

function hbar(cid,entries,total,fillCls='fill-green',max=10){
  const el=document.getElementById(cid);if(!el)return;
  if(!entries.length){el.innerHTML='<div class="no-data">No data yet</div>';return;}
  el.innerHTML=entries.slice(0,max).map(([lbl,n])=>`
    <div class="hbar-item">
      <div class="hbar-meta"><span class="hbar-label">${esc(lbl)}</span><span class="hbar-vals"><span class="hbar-pct">${pct(n,total)}%</span><span class="hbar-n">(${n})</span></span></div>
      <div class="hbar-track"><div class="hbar-fill ${fillCls}" style="width:${pct(n,total)}%"></div></div>
    </div>`).join('');
}

