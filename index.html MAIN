/* ═══ WORD CLOUD ═══ */
const STOPWORDS=new Set(['the','and','to','of','a','in','is','for','are','that','it','be','with','on','we','our','have','has','need','should','more','needs','their','this','was','not','but','they','been','all','also','very','can','will','there','so','by','from','about','an','at','its','which','when','what','or','my','he','she','no','do','if','his','her','as','would','county','embu','ward','area','local','government']);
function wordCloud(cid,texts){
  const el=document.getElementById(cid);if(!el)return;
  if(!texts.length){el.innerHTML='<div class="no-data">No text responses yet</div>';return;}
  const wf={};texts.join(' ').toLowerCase().replace(/[^a-z\s]/g,' ').split(/\s+/).filter(w=>w.length>2&&!STOPWORDS.has(w)).forEach(w=>{wf[w]=(wf[w]||0)+1;});
  const sorted=Object.entries(wf).sort((a,b)=>b[1]-a[1]).slice(0,36);
  const max=sorted[0]?.[1]||1;
  const cols=['#1a4a2a','#c8963e','#b83232','#2563a8','#6b3fa0','#4caf78'];
  el.innerHTML=sorted.map(([w,cnt],i)=>{const sz=11+Math.round((cnt/max)*16);const col=cols[i%cols.length];return`<span class="word-pill" style="font-size:${sz}px;background:${col}18;color:${col};border:1px solid ${col}40">${esc(w)} <sup style="font-size:9px">${cnt}</sup></span>`;}).join('');
}

/* ═══ NEED CATEGORIZER ═══ */
function catNeed(t){
  t=t.toLowerCase();
  if(/road|tarmac|bridge|transport/.test(t))return'Roads & Transport';
  if(/water|irrigation|dam/.test(t))return'Water & Irrigation';
  if(/health|hospital|clinic|medicine/.test(t))return'Healthcare';
  if(/school|education|teacher|learn/.test(t))return'Education';
  if(/job|employ|youth|business|sme/.test(t))return'Employment & Youth';
  if(/electric|power|light/.test(t))return'Electricity';
  if(/farm|agri|livestock|crop/.test(t))return'Agriculture';
  if(/corrupt|account|transparen/.test(t))return'Accountability';
  if(/market|trade|invest/.test(t))return'Markets & Trade';
  if(/security|police|safe/.test(t))return'Security';
  return t.length>38?t.slice(0,36)+'…':t||'Other';
}

