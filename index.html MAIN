  document.getElementById('r-date').textContent=new Date().toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});
  const parts=[v('gf-constituency'),v('gf-ward'),v('gf-gender'),v('gf-age'),v('gf-governor')].filter(Boolean);
  document.getElementById('r-filter-lbl').textContent=parts.length?parts.join(' · '):'All Respondents';

  const gF=freq(data,'gender'),ageF=freq(data,'age'),conF=freq(data,'constituency'),wardF=freq(data,'ward');
  const eduF=freq(data,'education'),empF=freq(data,'employment'),vF=freq(data,'voter');
  const perfF=freq(data,'performance'),govF=freq(data,'governor'),partyF=freq(data,'party');
  const rutoF=freq(data,'reelectRuto'),devOF=freq(data,'devOffice'),worF=freq(data,'worship');
  const pAwareF=freq(data,'projectsAware'),missF=freq(data,'missedPromises');
  const nDelF=freqMulti(data,'notDelivered'),infoF=freqMulti(data,'infoSources');
  const smeF=freqMulti(data,'smeChallenges'),vrF=freqMulti(data,'voteReasons');
  const antiMbF=freqMulti(data,'notMbarire'),antiKvF=freqMulti(data,'notKivuti'),antiGiF=freqMulti(data,'notGitonga');
  const perfMean=meanScore(data,'performance',PERF_SCORE);

  /* Occupation normalized */
  const occF={};data.forEach(d=>{const k=normalizeOcc(d.occupation);if(k)occF[k]=(occF[k]||0)+1;});

  const top=(obj,k=1)=>sortDesc(obj).slice(0,k).map(([l,vv])=>`${l} (${pct(vv,n)}%)`).join(', ');
  const topLbl=(obj)=>sortDesc(obj)[0]?.[0]||'—';
  function ftbl(obj,tot,lbl='Response'){const rows=sortDesc(obj);return`<table class="r-table"><thead><tr><th>${lbl}</th><th>Count</th><th>%</th></tr></thead><tbody>${rows.map(([l,vv])=>`<tr><td>${esc(l)}</td><td class="num">${vv}</td><td class="num">${pct(vv,tot)}%</td></tr>`).join('')}</tbody></table>`;}

  /* Exec Summary */
  document.getElementById('r-exec-content').innerHTML=`
    <div class="r-finding">
      <h3>Key Findings at a Glance</h3>
      <p>This report analyses <strong>${n.toLocaleString()} survey responses</strong> across Embu County's four constituencies: Manyatta, Runyenjes, Mbeere North, and Mbeere South.</p>
      <p><strong>Demographics:</strong> ${pct(gF.Female||0,n)}% Female, ${pct(gF.Male||0,n)}% Male. Dominant age group: <strong>${sortDesc(ageF)[0]?.[0]||'—'}</strong>. Voter registration: <strong>${pct(vF.Yes||0,n)}%</strong>.</p>
      <p><strong>Governance:</strong> County performance rated <strong>${topLbl(perfF)}</strong> by most respondents (mean ${perfMean.toFixed(2)}/4.0). Top undelivered sector: <strong>${topLbl(nDelF)}</strong>.</p>
      <p><strong>Political Sentiment:</strong> Governor — Mbarire: <strong>${pct(govF['Cecily Mbarire']||0,n)}%</strong>, Kivuti: ${pct(govF['Lenny Kivuti']||0,n)}%, Gitonga: ${pct(govF['Gitonga Mukunji']||0,n)}%. Re-elect Ruto: <strong>${pct(rutoF.Yes||0,n)}%</strong>.</p>
      <p><strong>SME:</strong> Top business challenge: <strong>${topLbl(smeF)}</strong>. Primary info source: <strong>${topLbl(infoF)}</strong>.</p>
    </div>
    <div class="r-badge-row">
      <span class="r-badge rb-green">N = ${n}</span>
      <span class="r-badge rb-green">Voters: ${pct(vF.Yes||0,n)}%</span>
      <span class="r-badge rb-gold">Perf Mean: ${perfMean.toFixed(2)}/4</span>
      <span class="r-badge rb-red">Mbarire: ${pct(govF['Cecily Mbarire']||0,n)}%</span>
      <span class="r-badge rb-sky">Kivuti: ${pct(govF['Lenny Kivuti']||0,n)}%</span>
    </div>`;

  /* Demographics */
  document.getElementById('r-demo-content').innerHTML=`
    <h3>A1 — Gender</h3><p>${gF.Female||0} Female (${pct(gF.Female||0,n)}%), ${gF.Male||0} Male (${pct(gF.Male||0,n)}%).</p>${ftbl(gF,n,'Gender')}
    <h3>A5 — Age Profile</h3><p>Largest cohort: <strong>${topLbl(ageF)}</strong> at ${pct(sortDesc(ageF)[0]?.[1]||0,n)}%.</p>${ftbl(ageF,n,'Age Group')}
    <h3>A2 — Constituency</h3>${ftbl(conF,n,'Constituency')}
    <h3>A3 — Ward</h3>${ftbl(wardF,n,'Ward')}
    <h3>A6 — Education Level</h3>${ftbl(eduF,n,'Education')}
    <h3>A7 — Employment Status</h3>${ftbl(empF,n,'Employment')}
    <h3>A8 — Occupation (Normalized)</h3>${ftbl(occF,n,'Occupation Category')}`;

  /* Political */
  document.getElementById('r-pol-content').innerHTML=`
    <h3>B1 — Voter Registration</h3><p><strong>${pct(vF.Yes||0,n)}% registered</strong> (${vF.Yes||0}/${n}).</p>${ftbl(vF,n,'Registered?')}
    ${pct(vF.No||0,n)>20?`<div class="r-callout gold"><strong>Opportunity:</strong> ${vF.No||0} unregistered respondents represent a voter mobilisation target.</div>`:''}
    <h3>B2 — Areas Government Has NOT Delivered</h3><p>Top undelivered area: <strong>${topLbl(nDelF)}</strong>.</p>${ftbl(nDelF,n,'Sector')}`;

  /* Info */
  document.getElementById('r-info-content').innerHTML=`
    <h3>C1 — Political Information Sources</h3><p>Primary source: <strong>${topLbl(infoF)}</strong>. This informs optimal communication channels.</p>${ftbl(infoF,n,'Source')}`;

  /* Governance */
  document.getElementById('r-gov-content').innerHTML=`
    <h3>D1 — Government Performance</h3><p>Mean score: <strong>${perfMean.toFixed(2)}/4.0</strong>.</p>${ftbl(perfF,n,'Rating')}
    <h3>D2 — Aware of Delivered Projects?</h3>${ftbl(pAwareF,n,'Response')}
    <h3>D3 — Promises Not Delivered?</h3>${ftbl(missF,n,'Response')}
    <h3>D4 — Top Priority Needs (Weighted)</h3>
    ${(()=>{const pm={};data.forEach(d=>{const lines=(d.needs||'').split('\n').map(l=>l.replace(/^\d+[\.\)]\s*/,'').trim()).filter(Boolean);lines.forEach((line,idx)=>{const sc=Math.max(3-idx,1);const th=catNeed(line);pm[th]=(pm[th]||0)+sc;});});return`<table class="r-table"><thead><tr><th>Rank</th><th>Priority Need</th><th>Weighted Score</th></tr></thead><tbody>${Object.entries(pm).sort((a,b)=>b[1]-a[1]).slice(0,8).map(([l,s],i)=>`<tr><td class="num">#${i+1}</td><td>${esc(l)}</td><td class="num">${s}</td></tr>`).join('')}</tbody></table>`;})()}`;

  /* Economics */
  document.getElementById('r-eco-content').innerHTML=`
    <h3>E1 — SME Challenges</h3><p>Top challenge: <strong>${topLbl(smeF)}</strong>.</p>${ftbl(smeF,n,'Challenge')}`;

  /* Sentiment */
  const ppf={};data.forEach(d=>{const vv=(d.preferredPres||'').trim();if(vv&&d.reelectRuto==='No')ppf[vv]=(ppf[vv]||0)+1;});
  document.getElementById('r-sent-content').innerHTML=`
    <h3>G1 — Re-elect President Ruto?</h3>${ftbl(rutoF,n,'Response')}
    ${pct(rutoF.Yes||0,n)<50?`<div class="r-callout"><strong>Note:</strong> Majority oppose re-electing Ruto — significant political realignment possible.</div>`:''}
    <h3>G1.1 — Preferred Presidential Candidate (Named)</h3><p>Of ${rutoF.No||0} respondents who said No to Ruto, the following names were mentioned:</p>${ftbl(ppf,rutoF.No||1,'Candidate')}
    <h3>G2 — Governor Voting Intention</h3><p>Mbarire: <strong>${pct(govF['Cecily Mbarire']||0,n)}%</strong>, Kivuti: ${pct(govF['Lenny Kivuti']||0,n)}%, Gitonga: ${pct(govF['Gitonga Mukunji']||0,n)}%, Other: ${pct(govF.Other||0,n)}%.</p>${ftbl(govF,n,'Candidate')}
    <h3>G3 — Party Preference</h3>${ftbl(partyF,n,'Party')}
    <h3>G4 — Reasons FOR Voting (Governor)</h3>${ftbl(vrF,n,'Reason')}
    <h3>G5 — Reasons AGAINST Mbarire</h3>${ftbl(antiMbF,n,'Reason')}
    <h3>G7 — Reasons AGAINST Kivuti</h3>${ftbl(antiKvF,n,'Reason')}
    <h3>G8 — Reasons AGAINST Gitonga Mukunji</h3>${ftbl(antiGiF,n,'Reason')}
    <h3>G9 — Candidate Preferences</h3>
    <table class="r-table"><thead><tr><th>Position</th><th>Top Choice</th><th>%</th></tr></thead><tbody>
      <tr><td>Senator</td><td>${topLbl(cleanCandFreq('prefSenator'))}</td><td class="num">${pct(sortDesc(cleanCandFreq('prefSenator'))[0]?.[1]||0,n)}%</td></tr>
      <tr><td>Women Representative</td><td>${topLbl(cleanCandFreq('prefWomenRep'))}</td><td class="num">${pct(sortDesc(cleanCandFreq('prefWomenRep'))[0]?.[1]||0,n)}%</td></tr>
      <tr><td>Member of Parliament</td><td>${topLbl(cleanCandFreq('prefMP'))}</td><td class="num">${pct(sortDesc(cleanCandFreq('prefMP'))[0]?.[1]||0,n)}%</td></tr>
      <tr><td>Member of County Assembly</td><td>${topLbl(cleanCandFreq('prefMCA'))}</td><td class="num">${pct(sortDesc(cleanCandFreq('prefMCA'))[0]?.[1]||0,n)}%</td></tr>
    </tbody></table>`;

  /* Community */
  document.getElementById('r-comm-content').innerHTML=`
    <h3>H1 — Office Contributing Most to Development</h3>${ftbl(devOF,n,'Office')}
    <h3>H2 — Worship Attendance</h3>${ftbl(worF,n,'Frequency')}`;

  /* Cross-tab */
  document.getElementById('r-cross-content').innerHTML=`
    <h3>Governor Preference by Constituency (G2 × A2)</h3>
    <table class="r-table"><thead><tr><th>Constituency</th>${GOV_CANDS.map(g=>`<th>${esc(g)}</th>`).join('')}<th>N</th></tr></thead><tbody>
    ${CONSTITS.map(c=>{const sub=data.filter(d=>d.constituency===c);if(!sub.length)return'';return`<tr><td>${c}</td>${GOV_CANDS.map(g=>{const cnt=sub.filter(d=>d.governor===g).length;return`<td class="num">${pct(cnt,sub.length)}%</td>`;}).join('')}<td class="num">${sub.length}</td></tr>`;}).join('')}
    </tbody></table>
    <h3>Re-elect Ruto by Constituency (G1 × A2)</h3>
    <table class="r-table"><thead><tr><th>Constituency</th><th>Yes %</th><th>No %</th><th>N</th></tr></thead><tbody>
    ${CONSTITS.map(c=>{const sub=data.filter(d=>d.constituency===c);if(!sub.length)return'';const y=sub.filter(d=>d.reelectRuto==='Yes').length;return`<tr><td>${c}</td><td class="num">${pct(y,sub.length)}%</td><td class="num">${pct(sub.length-y,sub.length)}%</td><td class="num">${sub.length}</td></tr>`;}).join('')}
    </tbody></table>
    <h3>Performance by Age Group (D1 × A5)</h3>
    <table class="r-table"><thead><tr><th>Age</th>${PERF_ORDER.map(p=>`<th>${p}</th>`).join('')}<th>Mean</th><th>N</th></tr></thead><tbody>
    ${AGE_ORDER.map(ag=>{const sub=data.filter(d=>d.age===ag);if(!sub.length)return'';const m=meanScore(sub,'performance',PERF_SCORE);return`<tr><td>${ag}</td>${PERF_ORDER.map(p=>`<td class="num">${pct(sub.filter(d=>d.performance===p).length,sub.length)}%</td>`).join('')}<td class="num">${m.toFixed(2)}</td><td class="num">${sub.length}</td></tr>`;}).join('')}
    </tbody></table>
    <h3>Governor Pick × Performance Rating (Partisan Bias Check)</h3>
    <table class="r-table"><thead><tr><th>Governor Pick</th>${PERF_ORDER.map(p=>`<th>${p}</th>`).join('')}<th>Mean</th><th>N</th></tr></thead><tbody>
    ${GOV_CANDS.map(g=>{const sub=data.filter(d=>d.governor===g);if(!sub.length)return'';const m=meanScore(sub,'performance',PERF_SCORE);return`<tr><td>${esc(g)}</td>${PERF_ORDER.map(p=>`<td class="num">${pct(sub.filter(d=>d.performance===p).length,sub.length)}%</td>`).join('')}<td class="num">${m.toFixed(2)}</td><td class="num">${sub.length}</td></tr>`;}).join('')}
    </tbody></table>`;

  /* Recommendations */
  const antiMbTop=topLbl(antiMbF),antiKvTop=topLbl(antiKvF),antiGiTop=topLbl(antiGiF);
  const topNeedLabel=(()=>{const pm={};data.forEach(d=>{const lines=(d.needs||'').split('\n').map(l=>l.replace(/^\d+[\.\)]\s*/,'').trim()).filter(Boolean);lines.forEach((line,idx)=>{const sc=Math.max(3-idx,1);const th=catNeed(line);pm[th]=(pm[th]||0)+sc;});});return Object.entries(pm).sort((a,b)=>b[1]-a[1])[0]?.[0]||'—';})();
  document.getElementById('r-rec-content').innerHTML=`
    <h3>For County Government / Incumbent</h3>
    <ul>
      <li>Address the most cited undelivered sector — <strong>${topLbl(nDelF)}</strong> — with visible, ward-level projects.</li>
      <li>Improve communication through <strong>${topLbl(infoF)}</strong> (top cited information source), barazas, and community radio.</li>
      <li>Priority needs analysis identifies <strong>${topNeedLabel}</strong> as the top community priority — budget alignment here signals responsiveness.</li>
    </ul>
    <h3>For Cecily Mbarire's Campaign</h3>
    <div class="r-callout"><strong>Primary vulnerability:</strong> "${antiMbTop}" — proactively address this with a concrete action plan, not defensive posturing.</div>
    <ul>
      <li>With ${pct(govF['Cecily Mbarire']||0,n)}% governor intent, the lead must be protected in stronghold constituencies.</li>
      <li>Target undecided voters with ward-level development commitments on the top 3 priority needs.</li>
    </ul>
    <h3>For Lenny Kivuti's Campaign</h3>
    <div class="r-callout gold"><strong>Primary vulnerability:</strong> "${antiKvTop}" — build a clear counter-narrative grounded in community-specific evidence.</div>
    <ul>
      <li>Mobilise unregistered voters (${vF.No||0} respondents) as an untapped electoral base.</li>
      <li>Youth (${pct((ageF['18-34']||0),n)}% of sample aged 18–34) are a critical bloc — employment and SME support should anchor youth manifesto.</li>
    </ul>
    <h3>For Gitonga Mukunji's Campaign</h3>
    <div class="r-callout"><strong>Primary vulnerability:</strong> "${antiGiTop}".</div>
    <ul>
      <li>Current support at ${pct(govF['Gitonga Mukunji']||0,n)}% — focus campaign presence in underserved wards where incumbency fatigue is highest.</li>
    </ul>
    <h3>Methodology Notes</h3>
    <ul>
      <li>Based on ${n} responses. Sub-group analyses with fewer than 30 respondents should be interpreted cautiously.</li>
      <li>The G2 × D1 cross-tab confirms partisan bias in performance ratings — Mbarire supporters rate performance significantly higher than non-supporters.</li>
      <li>Occupation data normalized from free-text into categories. Raw values available in Excel export.</li>
      <li>Word frequency in open text (D2, D3, D4, G6) is indicative. Full thematic coding recommended for strategic use.</li>
      <li>Hero stat totals (N, Gender, GPS Verified) always reflect all responses regardless of active filters.</li>
    </ul>`;
}

/* ═══ EXCEL EXPORT ═══ */
function exportExcel(){
  if(!data.length)return toast('No data loaded','#b83232');
  const stamp=new Date().toISOString().slice(0,10);
  const n=data.length;
  function rows(obj,lbl='Response'){const r=[[lbl,'Count','%']];sortDesc(obj).forEach(([l,vv])=>r.push([l,vv,pct(vv,n)+'%']));r.push(['TOTAL',n,'100%']);return r;}
  const wb=XLSX.utils.book_new();
  function addSh(name,d){XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(d),name.slice(0,31));}

  /* A8 Normalized occupation */
  const occF={};data.forEach(d=>{const k=normalizeOcc(d.occupation);if(k)occF[k]=(occF[k]||0)+1;});

  /* G1.1 preferred pres */
  const ppf={};data.forEach(d=>{const vv=(d.preferredPres||'').trim();if(vv&&d.reelectRuto==='No')ppf[vv]=(ppf[vv]||0)+1;});

  addSh('Demographics',[
    ['ECS-2026 DEMOGRAPHICS',`N=${n}`,stamp],[],
    ['A1 GENDER'],...rows(freq(data,'gender'),'Gender'),[],
    ['A5 AGE'],...rows(freq(data,'age'),'Age Group'),[],
    ['A2 CONSTITUENCY'],...rows(freq(data,'constituency'),'Constituency'),[],
    ['A3 WARD'],...rows(freq(data,'ward'),'Ward'),[],
    ['A6 EDUCATION'],...rows(freq(data,'education'),'Education'),[],
    ['A7 EMPLOYMENT'],...rows(freq(data,'employment'),'Employment'),[],
    ['A8 OCCUPATION (Normalized)'],...rows(occF,'Occupation Category')
  ]);
  addSh('Political-B',[
    ['SECTION B'],[],
    ['B1 VOTER REGISTRATION'],...rows(freq(data,'voter'),'Registered?'),[],
    ['B2 NOT DELIVERED (multi-select)'],...rows(freqMulti(data,'notDelivered'),'Sector')
  ]);
  addSh('Information-C',[
    ['SECTION C'],[],
    ['C1 INFORMATION SOURCES'],...rows(freqMulti(data,'infoSources'),'Source')
  ]);
  addSh('Governance-D',[
    ['SECTION D'],[],
    ['D1 PERFORMANCE'],...rows(freq(data,'performance'),'Rating'),[],
    ['D2 AWARE OF PROJECTS'],...rows(freq(data,'projectsAware'),'Response'),[],
    ['D3 MISSED PROMISES'],...rows(freq(data,'missedPromises'),'Response')
  ]);
  addSh('Economics-E',[
    ['SECTION E'],[],
    ['E1 SME CHALLENGES (multi-select)'],...rows(freqMulti(data,'smeChallenges'),'Challenge')
  ]);
  addSh('Sentiment-G',[
    ['SECTION G'],[],
    ['G1 RE-ELECT RUTO'],...rows(freq(data,'reelectRuto'),'Response'),[],
    ['G1.1 PREFERRED PRESIDENT (named, No-to-Ruto only)'],...rows(ppf,'Candidate'),[],
    ['G2 GOVERNOR INTENTION'],...rows(freq(data,'governor'),'Candidate'),[],
    ['G3 PARTY PREFERENCE'],...rows(freq(data,'party'),'Party'),[],
    ['G4 VOTE REASONS (multi)'],...rows(freqMulti(data,'voteReasons'),'Reason'),[],
    ['G5 ANTI-MBARIRE (multi)'],...rows(freqMulti(data,'notMbarire'),'Reason'),[],
    ['G7 ANTI-KIVUTI (multi)'],...rows(freqMulti(data,'notKivuti'),'Reason'),[],
    ['G8 ANTI-GITONGA (multi)'],...rows(freqMulti(data,'notGitonga'),'Reason'),[],
    ['G9 SENATOR (cleaned)'],...rows(cleanCandFreq('prefSenator'),'Candidate'),[],
    ['G9 WOMEN REP (cleaned)'],...rows(cleanCandFreq('prefWomenRep'),'Candidate'),[],
    ['G9 MP (cleaned)'],...rows(cleanCandFreq('prefMP'),'Candidate'),[],
    ['G9 MCA (cleaned)'],...rows(cleanCandFreq('prefMCA'),'Candidate')
  ]);
  addSh('Community-H',[
    ['SECTION H'],[],
    ['H1 DEV OFFICE'],...rows(freq(data,'devOffice'),'Office'),[],
    ['H2 WORSHIP'],...rows(freq(data,'worship'),'Frequency')
  ]);
  addSh('CrossTab-Gov×Const',[
    ['GOVERNOR × CONSTITUENCY'],
    ['Constituency',...GOV_CANDS,'N'],
    ...CONSTITS.map(c=>{const sub=data.filter(d=>d.constituency===c);if(!sub.length)return[];return[c,...GOV_CANDS.map(g=>pct(sub.filter(d=>d.governor===g).length,sub.length)+'%'),sub.length];}).filter(r=>r.length)
  ]);
  addSh('PSValidation',[
    ['A4 POLLING STATION VALIDATION'],
    ['Status','Count','%'],
    ...sortDesc((()=>{const pvRaw=freq(data,'_psValidation');const pvf={};Object.entries(pvRaw).forEach(([k,vv])=>{pvf[PS_LABEL_MAP[k]||k]=vv;});return pvf;})()).map(([l,vv])=>[l,vv,pct(vv,n)+'%'])
  ]);
  addSh('Summary',[
    ['METRIC','VALUE','NOTE'],
    ['Total Respondents',n,''],
    ['Female',`${freq(data,'gender').Female||0} (${pct(freq(data,'gender').Female||0,n)}%)`,'A1'],
    ['Male',`${freq(data,'gender').Male||0} (${pct(freq(data,'gender').Male||0,n)}%)`,'A1'],
    ['Registered Voters',`${freq(data,'voter').Yes||0} (${pct(freq(data,'voter').Yes||0,n)}%)`,'B1'],
    ['Re-elect Ruto Yes',`${pct(freq(data,'reelectRuto').Yes||0,n)}%`,'G1'],
    ['Perf Mean',`${meanScore(data,'performance',PERF_SCORE).toFixed(2)}/4.0`,'D1'],
    ['Mbarire Governor Intent',`${pct(freq(data,'governor')['Cecily Mbarire']||0,n)}%`,'G2'],
    ['Kivuti Governor Intent',`${pct(freq(data,'governor')['Lenny Kivuti']||0,n)}%`,'G2'],
    ['Gitonga Governor Intent',`${pct(freq(data,'governor')['Gitonga Mukunji']||0,n)}%`,'G2'],
    ['GPS Verified',`${rawData.filter(d=>d._gpsLat&&!d._gpsSkipped).length} (${pct(rawData.filter(d=>d._gpsLat&&!d._gpsSkipped).length,rawData.length)}%)`,'Field'],
    ['Active Researchers',new Set(rawData.map(d=>d._researcherLogin||d._researcher).filter(Boolean)).size,'Field']
  ]);
  XLSX.writeFile(wb,`ecs2026_analysis_${stamp}.xlsx`);
  toast(`✓ Excel exported — 11 sheets, N=${n}`,'#1a4a2a');
}

/* ═══ TOAST ═══ */
let tt;
function toast(msg,bg='#0c1a0e'){const el=document.getElementById('toast');el.textContent=msg;el.style.background=bg;el.style.transform='translateY(0)';el.style.opacity='1';clearTimeout(tt);tt=setTimeout(()=>{el.style.transform='translateY(80px)';el.style.opacity='0';},3500);}
</script>
</body>
</html>
